@model BoardModel.BoardColumn

<section id="column-@Model.Status" class="column">
    <h2>@Model.Status <span class="count">@Model.Cards.Count</span></h2>
    <div id="cards-@Model.Status" class="cards">
        @foreach (var card in Model.Cards)
        {
            <article id="card-@card.Id" class="card">
                <h3>@card.Name</h3>
                <time>@card.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</time>
            </article>
        }
        @if (Model.Cards.Count == 0)
        {
            <p class="empty">No builds</p>
        }
    </div>
</section>
